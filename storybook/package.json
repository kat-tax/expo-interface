    "@storybook/addon-ondevice-controls": "^10.5.4",
    "@storybook/addon-ondevice-notes": "^10.5.4",
    "@storybook/react-native": "^10.5.4",
    "expo": "~56.0.9",
    "expo-constants": "~56.0.16",
    "expo-image": "~56.0.10",
