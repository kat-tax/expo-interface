{
  "name": "expo-vitest",
  "version": "0.1.0",
  "description": "Vitest for Expo code on every platform it runs on: one project each for iOS, Android, web and Windows, picked by a test file's name, and a harness that drives the running app and reads its accessibility tree.",
  "license": "MIT",
  "author": "kat-tax",
  "homepage": "https://github.com/kat-tax/expo-vitest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kat-tax/expo-vitest.git"
  },
  "bugs": {
    "url": "https://github.com/kat-tax/expo-vitest/issues"
  },
  "keywords": [
    "expo",
    "vitest",
    "react-native",
    "react-native-windows",
    "react-native-web",
    "testing",
    "accessibility"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "default": "./dist/windows.js"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "default": "./dist/router.js"
    },
    "./device": {
      "types": "./dist/device/index.d.ts",
      "default": "./dist/device/index.js"
    },
    "./device/matchers": {
      "types": "./dist/device/matchers.d.ts",
      "default": "./dist/device/matchers.js"
    },
    "./metro-compat": {
      "types": "./dist/metro-compat.d.ts",
      "default": "./dist/metro-compat.js"
    },
    "./types": {
      "types": "./types.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "expo-harness": "./dist/harness/index.js"
  },
  "files": [
    "dist",
    "types.d.ts",
    "README.md",
    "HARNESS.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fixture": "node scripts/fixture.js",
    "prepack": "node scripts/build.js"
  },
  "peerDependencies": {
    "@testing-library/jest-dom": ">=6",
    "@testing-library/react": ">=16",
    "@testing-library/react-native": ">=13 <15",
    "expo": "^57.0.0",
    "expo-router": "^57.0.0",
    "jsdom": "*",
    "playwright-core": "*",
    "react": "*",
    "react-native": "*",
    "typescript": ">=5.7",
    "vite": ">=6 <9",
    "vitest": ">=4 <6",
    "vitest-expo": "^57.1.0",
    "vitest-native": ">=0.13 <0.14"
  },
  "peerDependenciesMeta": {
    "@testing-library/jest-dom": {
      "optional": true
    },
    "@testing-library/react": {
      "optional": true
    },
    "expo-router": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/babel-preset": "0.86.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.62.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-expo": "^57.1.0",
    "vitest-native": "^0.13.0"
  },
  "packageManager": "bun@1.4.0"
}
