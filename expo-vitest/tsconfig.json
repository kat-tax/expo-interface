{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "types": [
      "vitest/globals",
      "vitest-expo/types",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "types.d.ts"
  ]
}
