{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "target": "ES2022"
  },
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
