{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": [
      "vitest-expo/types",
      "node",
      "@testing-library/jest-dom/vitest",
      "expo-vitest/types"
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "expo-vitest/*": ["./expo-vitest/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
