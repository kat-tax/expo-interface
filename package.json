{
  "name": "expo-interface",
  "version": "0.1.0",
  "description": "Native-first universal UI kit for Expo — SwiftUI on iOS, Jetpack Compose on Android, real DOM on web — built on @expo/ui.",
  "license": "MIT",
  "author": "kat-tax",
  "homepage": "https://github.com/kat-tax/expo-interface#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kat-tax/expo-interface.git"
  },
  "bugs": {
    "url": "https://github.com/kat-tax/expo-interface/issues"
  },
  "keywords": [
    "expo",
    "expo-ui",
    "react-native",
    "swiftui",
    "jetpack-compose",
    "ui-kit",
    "design-system",
    "universal"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": [
    "**/*.css",
    "src/theme.ts",
    "src/screen/index.tsx"
  ],
  "files": [
    "src",
    "!src/__stories__",
    "!src/__tests__",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "example",
    "storybook"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && bun run --cwd example typecheck && bun run --cwd storybook typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "start": "bun run --cwd example start",
    "web": "bun run --cwd example web",
    "ios": "bun run --cwd example ios",
    "android": "bun run --cwd example android",
    "storybook": "bun run --cwd storybook start",
    "storybook:web": "bun run --cwd storybook web",
    "storybook:ios": "bun run --cwd storybook ios",
    "storybook:android": "bun run --cwd storybook android",
    "storybook:build": "bun run --cwd storybook build"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "peerDependencies": {
    "@expo/material-symbols": "*",
    "@expo/ui": "^56.0.0",
    "expo": "^56.0.0",
    "expo-constants": "*",
    "expo-image": "*",
    "expo-router": "^56.0.0",
    "expo-status-bar": "*",
    "expo-symbols": "*",
    "expo-system-ui": "*",
    "expo-web-browser": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "@expo/material-symbols": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.4.0",
  "overrides": {
    "react-native-screens": "~4.26.0"
  }
}
