{
  "name": "expo-interface",
  "version": "0.1.1",
  "description": "Native-first universal UI kit for Expo — SwiftUI on iOS, Jetpack Compose on Android, real DOM on web — built on @expo/ui.",
  "license": "MIT",
  "author": "kat-tax",
  "homepage": "https://github.com/kat-tax/expo-interface#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kat-tax/expo-interface.git"
  },
  "bugs": {
    "url": "https://github.com/kat-tax/expo-interface/issues"
  },
  "keywords": [
    "expo",
    "expo-ui",
    "react-native",
    "swiftui",
    "jetpack-compose",
    "ui-kit",
    "design-system",
    "universal"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "sideEffects": [
    "**/*.css",
    "src/theme.ts",
    "src/screen/index.tsx"
  ],
  "files": [
    "src",
    "!src/matchers.d.ts",
    "!src/__stories__",
    "!src/__tests__",
    "!src/**/*.stories.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "workspaces": [
    "example",
    "storybook"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && bun run --cwd example typecheck && bun run --cwd storybook typecheck",
    "lint": "oxlint --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "start": "bun run --cwd example start",
    "web": "bun run --cwd example web",
    "ios": "bun run --cwd example ios",
    "android": "bun run --cwd example android",
    "storybook": "bun run --cwd storybook start",
    "storybook:web": "bun run --cwd storybook web",
    "storybook:ios": "bun run --cwd storybook ios",
    "storybook:android": "bun run --cwd storybook android",
    "storybook:build": "bun run --cwd storybook build",
    "storybook:test": "bun run --cwd storybook test",
    "test:ui": "vitest --ui"
  },
  "peerDependencies": {
    "@expo/material-symbols": "*",
    "@expo/ui": "^57.0.0",
    "expo": "^57.0.0",
    "expo-constants": "*",
    "expo-image": "*",
    "expo-router": "^57.0.0",
    "expo-status-bar": "*",
    "expo-symbols": "*",
    "expo-system-ui": "*",
    "expo-web-browser": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "peerDependenciesMeta": {
    "@expo/material-symbols": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.81.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-expo": "^57.1.0",
    "vitest-native": "^0.13.0"
  },
  "packageManager": "bun@1.4.0"
}
