{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "paths": {
      "expo-interface": ["../src/index.ts"]
    },
    "types": [
      "vitest-expo/types",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "metro/**/*.js",
    "metro/**/*.d.ts",
    "cli/**/*.js"
  ]
}
