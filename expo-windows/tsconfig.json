{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "types": [
      "vitest-expo/types",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "metro/**/*.js",
    "metro/**/*.d.ts",
    "cli/**/*.js"
  ]
}
