{
  "name": "expo-windows",
  "version": "0.1.0",
  "description": "Windows for Expo apps on react-native-windows: the Metro config for the platform, an Expo Modules Core over the JavaScript registry, the modules the Expo packages call, and the app scaffold.",
  "license": "MIT",
  "author": "kat-tax",
  "homepage": "https://github.com/kat-tax/expo-interface/tree/master/expo-windows#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kat-tax/expo-interface.git",
    "directory": "expo-windows"
  },
  "keywords": [
    "expo",
    "react-native-windows",
    "windows",
    "winui",
    "metro",
    "expo-modules-core"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "bin": {
    "expo-windows": "cli/index.js"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "metro",
    "cli",
    "!cli/**/*.test.js",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo": "^57.0.0",
    "expo-modules-core": "*",
    "react": "*",
    "react-native": "*"
  }
}
