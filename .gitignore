# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo


# generated native folders
/example/ios
/example/android
/storybook/ios
/storybook/android

# storybook (generated by withStorybook / sb-rn-get-stories)
storybook/.rnstorybook/storybook.requires.ts

# tests
coverage/
test-report/
# vitest browser mode saves a screenshot next to a failing story
__screenshots__/
# …but a recorded device baseline is meant to be committed
!device/__screenshots__/
!device/__screenshots__/**

# Claude Code: the shared configuration is committed, the personal parts are not
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/agent-memory-local/
.claude/worktrees/

# harness screenshots
.harness/
